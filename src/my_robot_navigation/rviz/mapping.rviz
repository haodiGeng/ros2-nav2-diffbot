Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: map
    Frame Rate: 15
    Background Color: 48; 48; 48
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Value: true
    Cell Size: 0.1
    Plane Cell Count: 20
  - Class: rviz_default_plugins/RobotModel
    Name: RobotModel
    Enabled: true
    Value: true
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 1
    Visual Enabled: true
    Collision Enabled: false
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: false
    Value: false
    Marker Scale: 0.15
    Show Axes: true
    Show Names: true
    Show Arrows: false
    Frames:
      All Enabled: true
  - Class: rviz_default_plugins/Map
    Name: Map
    Enabled: true
    Value: true
    Alpha: 0.8
    Color Scheme: map
    Draw Behind: true
    Topic:
      Value: /map
      Depth: 1
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      History Policy: Keep Last
  - Class: rviz_default_plugins/LaserScan
    Name: LaserScan
    Enabled: true
    Value: true
    Topic:
      Value: /scan
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Best Effort
      History Policy: Keep Last
    Color Transformer: FlatColor
    Color: 255; 50; 50
    Position Transformer: XYZ
    Style: Points
    Size (Pixels): 3
    Size (m): 0.01
    Decay Time: 0
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 75.0
      Angle: 0.0
      X: 0.0
      Y: 0.0
      Target Frame: map
Window Geometry:
  Width: 1200
  Height: 800
