<!-- Dedicated gated mission keeps its clearance planner; no motion recovery. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <PipelineSequence name="ClearanceNavigation">
      <RateController hz="1.0">
        <ComputePathToPose goal="{goal}" path="{path}" planner_id="ClearanceGate"/>
      </RateController>
      <FollowPath path="{path}" controller_id="FollowPath"/>
    </PipelineSequence>
  </BehaviorTree>
</root>
