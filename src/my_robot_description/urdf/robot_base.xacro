<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="wheel" params="side y">
    <link name="${side}_wheel_link">
      <visual><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry><material name="black"/></visual>
      <xacro:unless value="$(arg simulation)">
        <collision><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision>
      </xacro:unless>
      <xacro:if value="$(arg simulation)">
        <!-- Rounded-tire approximation: central tread controls ground contact;
             shoulders keep the full width without a flat edge at ground level. -->
        <collision name="tread"><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wheel_radius}" length="0.002"/></geometry></collision>
        <collision name="shoulder"><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wheel_radius-0.002}" length="${wheel_width}"/></geometry></collision>
      </xacro:if>
      <!-- Cylinder axis is Y after rotation; use inertia in the link axes. -->
      <inertial><mass value="0.5"/><inertia ixx="${0.5*(3*wheel_radius**2+wheel_width**2)/12}" iyy="${0.5*wheel_radius**2/2}" izz="${0.5*(3*wheel_radius**2+wheel_width**2)/12}" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${side}_wheel_link"/>
      <origin xyz="${wheel_x} ${y} 0"/><axis xyz="0 1 0"/>
      <limit effort="10" velocity="15"/><dynamics damping="0.01"/>
    </joint>
  </xacro:macro>
  <xacro:macro name="robot_base">
    <link name="base_footprint"/>
    <joint name="base_footprint_joint" type="fixed">
      <parent link="base_footprint"/><child link="base_link"/>
      <origin xyz="0 0 ${wheel_radius}"/>
    </joint>
    <link name="base_link">
      <visual><origin xyz="${body_x} 0 ${base_height/2}"/><geometry><box size="${base_len} ${base_width} ${base_height}"/></geometry><material name="blue"/></visual>
      <collision><origin xyz="${body_x} 0 ${base_height/2}"/><geometry><box size="${base_len} ${base_width} ${base_height}"/></geometry></collision>
      <inertial><origin xyz="${body_x} 0 ${base_height/2}"/><mass value="5"/>
        <inertia ixx="${5*(base_width**2+base_height**2)/12}" iyy="${5*(base_len**2+base_height**2)/12}" izz="${5*(base_len**2+base_width**2)/12}" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <xacro:wheel side="left" y="${wheel_sep/2}"/>
    <xacro:wheel side="right" y="${-wheel_sep/2}"/>
    <link name="caster_link">
      <visual><geometry><sphere radius="0.025"/></geometry><material name="gray"/></visual>
      <collision><geometry><sphere radius="0.025"/></geometry></collision>
      <inertial><mass value="0.1"/><inertia ixx="0.000025" iyy="0.000025" izz="0.000025" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
    <joint name="caster_joint" type="fixed">
      <parent link="base_link"/><child link="caster_link"/>
      <origin xyz="-0.18 0 ${0.025-wheel_radius}"/>
    </joint>
  </xacro:macro>
</robot>
