<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="robot_laser">
    <link name="laser_link">
      <visual><geometry><cylinder radius="0.04" length="0.06"/></geometry><material name="red"/></visual>
      <collision><geometry><cylinder radius="0.04" length="0.06"/></geometry></collision>
      <inertial><mass value="0.2"/>
        <inertia ixx="${0.2*(3*0.04**2+0.06**2)/12}" iyy="${0.2*(3*0.04**2+0.06**2)/12}" izz="${0.2*0.04**2/2}" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="laser_joint" type="fixed">
      <parent link="base_link"/><child link="laser_link"/>
      <origin xyz="0.10 0 ${base_height+0.03}"/>
    </joint>
  </xacro:macro>
</robot>
