<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <gazebo>
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_topic>/model/my_robot/ground_truth</odom_topic><odom_frame>world</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame><dimensions>3</dimensions><odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_sep * drive_track_scale}</wheel_separation><wheel_radius>${wheel_radius}</wheel_radius>
      <topic>/model/my_robot/cmd_vel</topic><odom_topic>/model/my_robot/odometry</odom_topic>
      <tf_topic>/model/my_robot/tf</tf_topic><frame_id>odom</frame_id><child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_velocity>0.3</max_linear_velocity><min_linear_velocity>-0.3</min_linear_velocity>
      <max_angular_velocity>1.0</max_angular_velocity><min_angular_velocity>-1.0</min_angular_velocity>
      <max_linear_acceleration>0.5</max_linear_acceleration><min_linear_acceleration>-0.5</min_linear_acceleration>
      <max_angular_acceleration>1.5</max_angular_acceleration><min_angular_acceleration>-1.5</min_angular_acceleration>
    </plugin>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
      <joint_name>left_wheel_joint</joint_name><joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>
  <gazebo reference="left_wheel_link"><mu1>0.8</mu1><mu2>0.8</mu2></gazebo>
  <gazebo reference="right_wheel_link"><mu1>0.8</mu1><mu2>0.8</mu2></gazebo>
  <gazebo reference="caster_link"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  <gazebo reference="laser_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on><update_rate>15</update_rate>
      <topic>/model/my_robot/scan</topic><ignition_frame_id>laser_link</ignition_frame_id>
      <visualize>false</visualize>
      <lidar><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-${pi}</min_angle><max_angle>${pi}</max_angle></horizontal></scan>
        <range><min>0.05</min><max>12.0</max><resolution>0.01</resolution></range>
      </lidar>
    </sensor>
  </gazebo>
</robot>
