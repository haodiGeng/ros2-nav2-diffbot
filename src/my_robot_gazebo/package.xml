  <description>Fortress simulation, ROS bridges and motion validation for my_robot.</description>
  <maintainer email="geng@example.com">geng</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>my_robot_description</exec_depend><exec_depend>ros_gz_sim</exec_depend>
