<sdf version="1.7">
  <world name="warehouse">
    <physics type="ode">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin name="ignition::gazebo::systems::Physics" filename="libignition-gazebo-physics-system.so" />
    <plugin name="ignition::gazebo::systems::UserCommands" filename="libignition-gazebo-user-commands-system.so" />
    <plugin name="ignition::gazebo::systems::SceneBroadcaster" filename="libignition-gazebo-scene-broadcaster-system.so" />

    <scene>
      <ambient>1 1 1 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>0</shadows>
      <grid>false</grid>
    </scene>

    
    

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0.0 0.0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
        </collision>
      </link>
      <pose>0 0 0 0 0 0</pose>
    </model>

    
    <model name="wall_n"><static>true</static><pose>0 3 0.5 0 0 0</pose><link name="body"><visual name="visual"><geometry><box><size>6 0.15 1</size></box></geometry></visual><collision name="collision"><geometry><box><size>6 0.15 1</size></box></geometry></collision></link></model><model name="wall_s"><static>true</static><pose>0 -3 0.5 0 0 0</pose><link name="body"><visual name="visual"><geometry><box><size>6 0.15 1</size></box></geometry></visual><collision name="collision"><geometry><box><size>6 0.15 1</size></box></geometry></collision></link></model><model name="wall_e"><static>true</static><pose>3 0 0.5 0 0 0</pose><link name="body"><visual name="visual"><geometry><box><size>0.15 6 1</size></box></geometry></visual><collision name="collision"><geometry><box><size>0.15 6 1</size></box></geometry></collision></link></model><model name="wall_w"><static>true</static><pose>-3 0 0.5 0 0 0</pose><link name="body"><visual name="visual"><geometry><box><size>0.15 6 1</size></box></geometry></visual><collision name="collision"><geometry><box><size>0.15 6 1</size></box></geometry></collision></link></model><model name="test_box"><static>true</static><pose>1.2 0 0.25 0 0 0</pose><link name="body"><visual name="visual"><geometry><box><size>0.4 0.4 0.5</size></box></geometry></visual><collision name="collision"><geometry><box><size>0.4 0.4 0.5</size></box></geometry></collision></link></model></world>
</sdf>